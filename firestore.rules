rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Hardcoded superadmin allowlist — emergency-access escape hatch.
    // Keep this in sync with admin.html ALLOWED_EMAILS for the UX gate.
    function isSuperadmin() {
      return isSignedIn()
          && request.auth.token.email in [
               'aws.jason.b.tubilag@gmail.com',
               'jason.b.tubilag@gmail.com',
               'manilynp07@gmail.com'
             ];
    }

    function tenantExists(tid) {
      return exists(/databases/$(database)/documents/tenants/$(tid));
    }

    function isOwner(tid) {
      return isSignedIn()
          && tenantExists(tid)
          && request.auth.token.email in
             get(/databases/$(database)/documents/tenants/$(tid)).data.ownerEmails;
    }

    function isOwnerOrSuper(tid) {
      return isSuperadmin() || isOwner(tid);
    }

    // Customer order create — strict field validation
    function isValidOrderCreate() {
      let d = request.resource.data;
      return d.status == 'pending'
          && d.keys().hasAll(['status', 'customer', 'items', 'total'])
          && d.total is number
          && d.total >= 0
          && d.items is list
          && d.items.size() > 0
          && d.items.size() <= 200
          // Block admin-only fields on customer create
          && !('confirmedAt' in d)
          && !('cancelledAt' in d)
          && !('refundedAt' in d)
          && !('partialRefundAt' in d)
          && !('partialRefundRef' in d)
          && !('confirmedItems' in d)
          && !('uncheckedItems' in d);
    }

    // Customer product update — only stock decrement, no other changes
    function isStockDecrement() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['stock', 'variants', 'available'])
          && (!('stock' in changed)
              || (request.resource.data.stock is number
                  && request.resource.data.stock >= 0
                  && request.resource.data.stock <= resource.data.stock))
          && (!('available' in changed)
              || request.resource.data.available == false);
    }

    // ============================================================
    // TENANT DOC + SUBCOLLECTIONS
    // ============================================================

    match /tenants/{tid} {

      // Tenant doc: readable by owner/super, writable by super only
      allow get: if isOwnerOrSuper(tid);
      allow list: if isSuperadmin();
      allow create, update, delete: if isSuperadmin();

      // ---------- products: public read, owner write, narrow customer stock-decrement
      match /products/{pid} {
        allow read: if true;
        allow create, delete: if isOwnerOrSuper(tid);
        allow update: if isOwnerOrSuper(tid) || isStockDecrement();
      }

      // ---------- settings: public read, owner write
      match /settings/{sid} {
        allow read: if true;
        allow write: if isOwnerOrSuper(tid);
      }

      // ---------- orders: customers create with strict validation; owners read/update/delete
      match /orders/{oid} {
        allow read, update, delete: if isOwnerOrSuper(tid);
        allow create: if isValidOrderCreate();
      }

      // ---------- suppliers: private to the tenant's owners; never customer-facing
      match /suppliers/{sid} {
        allow read, write: if isOwnerOrSuper(tid);
      }

      // ---------- subscription: read by owner/super; writes only via Cloud
      //            Functions (admin SDK bypasses rules). Disallow client write
      //            so tenants can't extend their own subscription by editing
      //            the doc directly.
      match /subscription/{sid} {
        allow read: if isOwnerOrSuper(tid);
        allow write: if false;
      }

      // ---------- payments: per-payment record. Owner can create a
      //            pending_verification submission (with receipt upload) but
      //            cannot self-confirm. Superadmin confirms via Cloud Function.
      match /payments/{pid} {
        allow read: if isOwnerOrSuper(tid);
        allow create: if isOwnerOrSuper(tid)
                       && request.resource.data.status == 'pending_verification'
                       && request.resource.data.amount is number
                       && request.resource.data.amount > 0;
        allow update, delete: if false; // only Cloud Functions modify after create
      }
    }

    // ============================================================
    // STARTER PACK (root-level seed catalog used by createTenant)
    // ============================================================
    match /starter_pack/{pid} {
      allow read: if true;
      allow write: if isSuperadmin();
    }

    // ============================================================
    // PUBLIC DIRECTORY — anonymous-readable list of {slug, name}
    // pairs used by the signup-page store-finder. Writes happen only
    // through Cloud Functions (admin SDK) which bypass these rules,
    // so superadmin-write here is a defense-in-depth backstop.
    // ============================================================
    match /public/{doc} {
      allow read: if true;
      allow write: if isSuperadmin();
    }

    // ============================================================
    // INVITE CODES — fully closed to clients. All access (mint, list,
    // revoke, redeem) goes through Cloud Functions running with admin
    // privileges, so codes can never be enumerated or tampered with from
    // the browser even if a malicious user is signed in.
    // ============================================================
    match /invite_codes/{code} {
      allow read, write: if false;
    }

    // ============================================================
    // DEFAULT DENY for everything else (including legacy root paths
    // /products, /orders, /settings left behind after migration)
    // ============================================================
  }
}
