rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    // Hardcoded superadmin allowlist — emergency-access escape hatch.
    // Keep this in sync with admin.html ALLOWED_EMAILS for the UX gate.
    function isSuperadmin() {
      return isSignedIn()
          && request.auth.token.email in [
               'aws.jason.b.tubilag@gmail.com',
               'jason.b.tubilag@gmail.com',
               'manilynp07@gmail.com'
             ];
    }

    function tenantExists(tid) {
      return exists(/databases/$(database)/documents/tenants/$(tid));
    }

    function isOwner(tid) {
      return isSignedIn()
          && tenantExists(tid)
          && request.auth.token.email in
             get(/databases/$(database)/documents/tenants/$(tid)).data.ownerEmails;
    }

    function isOwnerOrSuper(tid) {
      return isSuperadmin() || isOwner(tid);
    }

    // ---------- Staff (employee) access ----------
    // A staff member has a doc at tenants/{tid}/members/{their-uid}. Accesses
    // to that one doc are cached within a rule evaluation, so the multiple
    // memberHas() checks below cost a single document read.
    function isMember(tid) {
      return isSignedIn()
          && exists(/databases/$(database)/documents/tenants/$(tid)/members/$(request.auth.uid));
    }
    function memberHas(tid, perm) {
      return isMember(tid)
          && get(/databases/$(database)/documents/tenants/$(tid)/members/$(request.auth.uid))
               .data.get('permissions', {}).get(perm, false) == true;
    }
    // Anti-fraud: a staff product write may NEVER increase stock (that's the
    // "sell an item, re-add the stock to hide the sale" move). stockincrease is
    // owner-only by design — staff can only leave stock unchanged or lower it.
    function staffStockNotIncreased() {
      let ch = request.resource.data.diff(resource.data).affectedKeys();
      return !('stock' in ch)
          || (resource.data.stock is number
              && request.resource.data.stock is number
              && request.resource.data.stock <= resource.data.stock);
    }

    // Customer order create — strict field validation
    function isValidOrderCreate() {
      let d = request.resource.data;
      return d.status == 'pending'
          && d.keys().hasAll(['status', 'customer', 'items', 'total'])
          && d.total is number
          && d.total >= 0
          && d.items is list
          && d.items.size() > 0
          && d.items.size() <= 200
          // Block admin-only fields on customer create
          && !('confirmedAt' in d)
          && !('cancelledAt' in d)
          && !('refundedAt' in d)
          && !('partialRefundAt' in d)
          && !('partialRefundRef' in d)
          && !('confirmedItems' in d)
          && !('uncheckedItems' in d);
    }

    // Customer product update — only stock decrement, no other changes
    function isStockDecrement() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['stock', 'variants', 'available'])
          && (!('stock' in changed)
              || (request.resource.data.stock is number
                  && request.resource.data.stock >= 0
                  && request.resource.data.stock <= resource.data.stock))
          && (!('available' in changed)
              || request.resource.data.available == false);
    }

    // Customer branch-inventory update — same shape as isStockDecrement
    // but for the new tenants/{tid}/branches/{bid}/inventory/{pid} subdocs.
    // Stock can only go DOWN, available can only go to false.
    function isBranchStockDecrement() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['stock', 'available', 'updatedAt'])
          && (!('stock' in changed)
              || (request.resource.data.stock is number
                  && request.resource.data.stock >= 0
                  && request.resource.data.stock <= resource.data.stock))
          && (!('available' in changed)
              || request.resource.data.available == false);
    }

    // ============================================================
    // TENANT DOC + SUBCOLLECTIONS
    // ============================================================

    match /tenants/{tid} {

      // Tenant doc: readable by owner/super/staff, writable by super only
      allow get: if isOwnerOrSuper(tid) || isMember(tid);
      allow list: if isSuperadmin();
      allow create, update, delete: if isSuperadmin();

      // ---------- products: public read; owner write; narrow customer
      //            stock-decrement; staff write gated by permission AND the
      //            anti-fraud stock-not-increased guard.
      match /products/{pid} {
        allow read: if true;
        allow create: if isOwnerOrSuper(tid) || memberHas(tid, 'productadd');
        allow delete: if isOwnerOrSuper(tid) || memberHas(tid, 'productdelete');
        allow update: if isOwnerOrSuper(tid)
                       || isStockDecrement()
                       || (isMember(tid) && staffStockNotIncreased()
                           && (memberHas(tid, 'productedit') || memberHas(tid, 'stockdecrease')
                               || memberHas(tid, 'availabilitytoggle') || memberHas(tid, 'visibilitytoggle')));
      }

      // ---------- settings: public read; owner/super or staff with settingsedit
      //            (mode toggles also via modestoggle) write.
      match /settings/{sid} {
        allow read: if true;
        allow write: if isOwnerOrSuper(tid)
                      || memberHas(tid, 'settingsedit') || memberHas(tid, 'modestoggle');
      }

      // ---------- orders: customers create with strict validation; owner/super
      //            full; staff read with orderstabview, update with confirm/cancel.
      match /orders/{oid} {
        allow read: if isOwnerOrSuper(tid) || memberHas(tid, 'orderstabview');
        allow update: if isOwnerOrSuper(tid)
                       || memberHas(tid, 'orderconfirm') || memberHas(tid, 'ordercancel') || memberHas(tid, 'orderrefund');
        allow delete: if isOwnerOrSuper(tid);
        allow create: if isValidOrderCreate();
      }

      // ---------- suppliers: owner/super or staff with the matching permission.
      match /suppliers/{sid} {
        allow read:   if isOwnerOrSuper(tid) || memberHas(tid, 'supplierstabview');
        allow create: if isOwnerOrSuper(tid) || memberHas(tid, 'supplieradd');
        allow update: if isOwnerOrSuper(tid) || memberHas(tid, 'supplieredit');
        allow delete: if isOwnerOrSuper(tid) || memberHas(tid, 'supplierdelete');
      }

      // ---------- subscription: read by owner/super or staff with a billing
      //            view perm; writes only via Cloud Functions (admin SDK).
      match /subscription/{sid} {
        allow read: if isOwnerOrSuper(tid)
                     || memberHas(tid, 'billingtabview') || memberHas(tid, 'billingpaymenthistoryview');
        allow write: if false;
      }

      // ---------- payments: owner can create a pending_verification submission;
      //            staff with billing view can read; only Cloud Functions confirm.
      match /payments/{pid} {
        allow read: if isOwnerOrSuper(tid)
                     || memberHas(tid, 'billingtabview') || memberHas(tid, 'billingpaymenthistoryview');
        allow create: if isOwnerOrSuper(tid)
                       && request.resource.data.status == 'pending_verification'
                       && request.resource.data.amount is number
                       && request.resource.data.amount > 0;
        allow update, delete: if false; // only Cloud Functions modify after create
      }

      // ---------- support_tickets: Pro-only ticket audit log. Created
      //            exclusively by the submitSupportTicket Cloud Function
      //            (admin SDK bypasses these rules). Owners + superadmins
      //            can read their own tenant's history; writes are blocked
      //            so a tenant can't fake a ticket or alter one post-submit.
      match /support_tickets/{ticketId} {
        allow read: if isOwnerOrSuper(tid);
        allow write: if false;
      }

      // ---------- Custom Domain (Pro feature) — schema lives at
      //            `tenants/{tid}.customDomain` (on the tenant root doc,
      //            not a subcollection). No new rules needed: the tenant
      //            root rules above already allow owner READ + block client
      //            writes; the submitCustomDomain / verifyCustomDomain /
      //            removeCustomDomain Cloud Functions update via admin SDK,
      //            bypassing rules. The public/customDomains lookup map
      //            used by the storefront head IIFE is covered by the
      //            existing `public/{doc}` rule below (anon-readable).

      // ---------- Multi-Branch (Pro feature) — per-tenant subcollection
      //            of branch documents. Public-readable so the storefront
      //            branch picker works for anonymous customers; owner-write
      //            so Pro tenants manage their own branches from admin.
      //            Tier enforcement is client-side via LOCKED_FEATURES
      //            (Free/Growth see the upsell modal) since rules can't
      //            efficiently read subscription on every write.
      match /branches/{branchId} {
        allow read: if true;
        allow write: if isOwnerOrSuper(tid);

        // ---------- Per-branch inventory (Phase 3 — Pro multi-branch).
        //            Public-readable so the storefront can show per-branch
        //            stock + decrement on order placement. Owner can
        //            write/seed initial counts from admin; customers can
        //            only narrow-decrement stock (same pattern as the
        //            top-level products/{pid} rule above).
        match /inventory/{productId} {
          allow read: if true;
          allow create, delete: if isOwnerOrSuper(tid);
          allow update: if isOwnerOrSuper(tid) || isBranchStockDecrement();
        }
      }

      // ---------- Staff Accounts (Pro feature) — per-person employee members
      //            + pending invites. Written ONLY by the staff Cloud Functions
      //            (addStaffMember / acceptStaffInvite / updateStaffPermissions
      //            / removeStaffMember; Admin SDK bypasses these rules), so a
      //            client can NEVER self-grant or edit permissions. Owner/super
      //            read all; a staff member reads their OWN member doc to load
      //            their permissions on login.
      match /members/{uid} {
        allow read: if isOwnerOrSuper(tid) || (isSignedIn() && request.auth.uid == uid);
        allow write: if false;
      }
      match /staff_invites/{inviteId} {
        allow read: if isOwnerOrSuper(tid);
        allow write: if false;
      }
    }

    // ============================================================
    // STARTER PACK (root-level seed catalog used by createTenant)
    // ============================================================
    match /starter_pack/{pid} {
      allow read: if true;
      allow write: if isSuperadmin();
    }

    // ============================================================
    // PUBLIC DIRECTORY — anonymous-readable list of {slug, name}
    // pairs used by the signup-page store-finder. Writes happen only
    // through Cloud Functions (admin SDK) which bypass these rules,
    // so superadmin-write here is a defense-in-depth backstop.
    // ============================================================
    match /public/{doc} {
      allow read: if true;
      allow write: if isSuperadmin();
    }

    // ============================================================
    // PLATFORM CONFIG — owner-readable (so Pay-Now modals can show the
    // GCash account + reference info), superadmin-writable only.
    // Holds subscription payment receiving accounts (GCash, Maya instaPay).
    // ============================================================
    match /platform/{doc} {
      allow read: if isSignedIn();
      allow write: if isSuperadmin();
    }

    // ============================================================
    // INVITE CODES — fully closed to clients. All access (mint, list,
    // revoke, redeem) goes through Cloud Functions running with admin
    // privileges, so codes can never be enumerated or tampered with from
    // the browser even if a malicious user is signed in.
    // ============================================================
    match /invite_codes/{code} {
      allow read, write: if false;
    }

    // ============================================================
    // DEFAULT DENY for everything else (including legacy root paths
    // /products, /orders, /settings left behind after migration)
    // ============================================================
  }
}
