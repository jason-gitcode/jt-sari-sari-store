rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null
          && request.auth.token.email_verified == true;
    }

    function isSuperadmin() {
      return isSignedIn()
          && request.auth.token.email in [
               'aws.jason.b.tubilag@gmail.com',
               'jason.b.tubilag@gmail.com',
               'manilynp07@gmail.com'
             ];
    }

    // Ownership lives in a custom auth claim { tenants: [slug, ...] } set by
    // createTenant / backfillOwnerClaims. Storage rules can't reliably
    // cross-read Firestore (the old firestore.get() approach silently denied
    // real owners — only superadmin worked), so ownership is checked from the
    // ID token instead.
    function isOwner(tid) {
      return isSignedIn()
          && ('tenants' in request.auth.token)
          && (tid in request.auth.token.tenants);
    }

    function isOwnerOrSuper(tid) {
      return isSuperadmin() || isOwner(tid);
    }

    // ============================================================
    // TENANT-SCOPED PATHS
    // ============================================================

    match /tenants/{tid}/{allPaths=**} {
      // Public read for product images, etc.
      allow read: if true;
      // Only owners (or super) can upload/delete tenant assets
      allow write: if isOwnerOrSuper(tid)
                   && (request.resource == null
                       || request.resource.size < 5 * 1024 * 1024);
    }

    // ============================================================
    // DEFAULT DENY for everything else (only superadmin)
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if isSuperadmin();
    }
  }
}
