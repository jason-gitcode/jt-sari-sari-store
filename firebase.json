{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      ".claude/**",
      ".firebase/**",
      ".DS_Store",
      "**/.DS_Store",
      "**/.*",
      "**/node_modules/**",
      "**/CLAUDE.md",
      "CNAME",
      "**/*.mp4",
      "**/*.md",
      "ScreenRecording_*"
    ],
    "redirects": [
      { "source": "/", "type": 302, "destination": "/jsminimart/" },
      { "source": "/index.html", "type": 302, "destination": "/jsminimart/" },
      { "source": "/admin.html", "type": 302, "destination": "/jsminimart/admin/" },
      { "source": "/checkout.html", "type": 302, "destination": "/jsminimart/checkout/" },
      { "source": "/checkout", "type": 302, "destination": "/jsminimart/checkout/" },
      { "source": "/checkout/", "type": 302, "destination": "/jsminimart/checkout/" },
      { "source": "/checkout/index.html", "type": 302, "destination": "/jsminimart/checkout/" }
    ],
    "rewrites": [
      { "source": "/*/admin", "destination": "/admin.html" },
      { "source": "/*/admin/", "destination": "/admin.html" },
      { "source": "/*/admin/**", "destination": "/admin.html" },
      { "source": "/*/checkout", "destination": "/checkout/index.html" },
      { "source": "/*/checkout/", "destination": "/checkout/index.html" },
      { "source": "/*/checkout/**", "destination": "/checkout/index.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico|PNG|JPEG)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
}
