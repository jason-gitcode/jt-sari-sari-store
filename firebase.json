{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      ".claude/**",
      ".firebase/**",
      ".DS_Store",
      "**/.DS_Store",
      "**/.*",
      "**/node_modules/**",
      "**/CLAUDE.md",
      "CNAME",
      "**/*.mp4",
      "**/*.md",
      "**/*.rules",
      "ScreenRecording_*"
    ],
    "redirects": [
      { "source": "/admin.html", "type": 302, "destination": "/jsminimart/admin/" },
      { "source": "/checkout.html", "type": 302, "destination": "/jsminimart/checkout/" },
      { "source": "/catalog-store", "type": 302, "destination": "/signup" },
      { "source": "/catalog-store/", "type": 302, "destination": "/signup" },
      { "source": "/catalog-store/checkout", "type": 302, "destination": "/signup" },
      { "source": "/catalog-store/checkout/", "type": 302, "destination": "/signup" },
      { "source": "/catalog-store/checkout/**", "type": 302, "destination": "/signup" }
    ],
    "rewrites": [
      { "source": "/signup", "destination": "/signup/index.html" },
      { "source": "/signup/**", "destination": "/signup/index.html" },
      { "source": "/auth", "destination": "/auth/index.html" },
      { "source": "/auth/**", "destination": "/auth/index.html" },
      { "source": "/superadmin", "destination": "/superadmin/index.html" },
      { "source": "/superadmin/**", "destination": "/superadmin/index.html" },
      { "source": "/*/admin", "destination": "/admin.html" },
      { "source": "/*/admin/", "destination": "/admin.html" },
      { "source": "/*/admin/**", "destination": "/admin.html" },
      { "source": "/*/checkout", "destination": "/checkout/index.html" },
      { "source": "/*/checkout/", "destination": "/checkout/index.html" },
      { "source": "/*/checkout/**", "destination": "/checkout/index.html" },
      { "source": "/checkout", "destination": "/checkout/index.html" },
      { "source": "/checkout/", "destination": "/checkout/index.html" },
      { "source": "/checkout/**", "destination": "/checkout/index.html" },
      { "source": "/og/**", "function": { "functionId": "ogImage", "region": "asia-southeast1" } },
      { "source": "**", "function": { "functionId": "storefrontMeta", "region": "asia-southeast1" } }
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico|PNG|JPEG)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  }
}
